{
  "name": "rabbit-ar-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Rabbit AR Lab — A1 학술 포스터 WebAR + 온디바이스 LLM 채팅 릴레이",
  "type": "module",
  "workspaces": [
    "apps/web-ar",
    "apps/relay-worker",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w @rabbit/web-ar run dev",
    "build": "npm -w @rabbit/web-ar run build",
    "preview": "npm -w @rabbit/web-ar run preview",
    "relay:dev": "npm -w @rabbit/relay-worker run dev",
    "relay:deploy": "npm -w @rabbit/relay-worker run deploy",
    "mock-device": "tsx scripts/mock-device.ts",
    "desktop-device": "tsx scripts/desktop-device.ts",
    "try:desktop": "tsx scripts/try-desktop.ts",
    "ask": "tsx scripts/ask-relay.ts",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e-relay.ts",
    "typecheck": "tsc -p packages/shared && tsc -p packages/educational-content && tsc -p apps/relay-worker && tsc -p apps/web-ar && tsc -p scripts",
    "validate:facts": "tsx scripts/validate-facts.ts",
    "export:rabbit": "tsx scripts/export-rabbit-sheets.ts",
    "make:qr": "tsx scripts/make-qr.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
