      "keywords": ["-40", "영하40", "40도", "75", "201", "185", "식각률", "식각속도", "깎는속도", "덜깎", "안깎", "비단조", "순서", "빨리깎", "속도", "sic식각률", "sic식각속도", "얼마", "몇nm"],
      "not": ["구리", "cu", "copper", "mo", "몰리브덴", "유리", "glass"],
