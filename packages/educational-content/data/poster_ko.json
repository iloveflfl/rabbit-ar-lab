    { "at": [1776, 1748], "a": "c", "t": "냉각 1", "s": 19, "w": "Regular", "c": "gray" },
    { "at": [1980, 1748], "a": "c", "t": "식각 2", "s": 19, "w": "Regular", "c": "gray" },
