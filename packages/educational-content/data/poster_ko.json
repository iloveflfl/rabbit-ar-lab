    { "r": [1278, 2450, 1620, 2486], "pad": 9, "t": "8인치 Al, 그리스 있음", "s": 21, "w": "Bold", "c": "ink" },
    { "r": [1262, 2520, 2380, 2592], "wrap": true, "lh": 33, "t": "바이어스가 140 V로 같은 두 Al 판 조건에서, 시편의 최종 온도는 그리스가 없을 때 78°C, 진공 그리스를 발랐을 때 76°C였다.", "s": 24, "w": "Regular", "c": "body" },

    { "r": [78, 2648, 1530, 2702], "t": "결과 및 논의  |  Cu 패턴 박막과 금속층의 반응", "s": 42, "w": "Bold", "c": "white" },
    { "r": [96, 2740, 830, 2772], "t": "Cu 식각 → PR 제거 → 묽은 HCl 세정 → 단차 측정", "s": 27, "w": "Bold", "c": "ink" },
    { "r": [80, 2784, 1640, 2858], "wrap": true, "lh": 33, "t": "HCl ECR-RIE 반복 공정을 거친 패턴 금속 박막은 식각 후 표면이 위치마다 고르지 않았다. PR을 벗기고 DI 200 mL : HCl 3 mL로 처리한 뒤 Alpha-Step으로 잰 단차는 시편마다 달랐다.", "s": 24, "w": "Regular", "c": "body" },
