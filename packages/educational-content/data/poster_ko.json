    { "r": [1298, 1806, 2420, 1874], "wrap": true, "lh": 32, "pad": 8, "t": "30초 플라즈마 펄스마다 측정 온도가 15.5–16°C 올랐고, 3분 쉴 때마다 다음 펄스 전까지 12.5–14°C 되돌아왔다.", "s": 23, "w": "Regular", "c": "body" },
    { "r": [1284, 1876, 2160, 1906], "t": "그림 3  −50°C 설정, ICP/RIE 1000/800 W, HCl 50 sccm, He 20 Torr. 펄스마다 잰 시편 온도.", "s": 17, "w": "Regular", "c": "gray" },

    { "r": [78, 1950, 1580, 2004], "t": "결과 및 논의  |  SiC 식각률과 시편 받침 구성", "s": 42, "w": "Bold", "c": "white" },
    { "r": [96, 2030, 720, 2068], "t": "설정 온도별 SiC 식각률 비교", "s": 27, "w": "Bold", "c": "ink" },
    { "r": [80, 2078, 1190, 2152], "wrap": true, "lh": 34, "t": "소스/바이어스 전력과 가스 조건을 같게 두고 칠러 설정을 −50, −40, −20°C로 바꾸자 SiC 식각률은 201, 75, 185 nm/min이었다. 온도 순서대로 늘거나 줄지 않았다.", "s": 25, "w": "Regular", "c": "body" },
    { "r": [88, 2178, 310, 2208], "t": "SiC 식각률 (nm/min)", "s": 19, "w": "Regular", "c": "gray" },
    { "r": [852, 2210, 1090, 2248], "t": "조건표", "s": 22, "w": "Bold", "c": "ink" },
    { "r": [848, 2262, 1100, 2294] },
    { "at": [856, 2278], "t": "설정", "s": 19, "w": "Medium", "c": "body" },
